{
  "$defs": {
    "MigrationReadinessGate": {
      "additionalProperties": false,
      "description": "One derived migration gate with references to its supporting records.",
      "properties": {
        "evidence_ids": {
          "default": [],
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Id",
          "type": "string"
        },
        "measured_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Measured Value"
        },
        "reason_codes": {
          "default": [],
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "required_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Required Value"
        },
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/MigrationReadinessStatus"
        }
      },
      "required": [
        "id",
        "status"
      ],
      "title": "MigrationReadinessGate",
      "type": "object"
    },
    "MigrationReadinessSection": {
      "additionalProperties": false,
      "description": "An ordered group of gates whose status is computed from those gates.",
      "properties": {
        "gate_results": {
          "items": {
            "$ref": "#/$defs/MigrationReadinessGate"
          },
          "minItems": 1,
          "title": "Gate Results",
          "type": "array"
        },
        "id": {
          "enum": [
            "CURRENT_SCOPE_CONFORMANCE",
            "SUPERVISED_SHADOW_READINESS",
            "FULL_SOURCE_CONFORMANCE",
            "SHADOW_GRADUATION"
          ],
          "title": "Id",
          "type": "string"
        },
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/MigrationReadinessStatus",
          "readOnly": true
        }
      },
      "required": [
        "id",
        "gate_results",
        "status"
      ],
      "title": "MigrationReadinessSection",
      "type": "object"
    },
    "MigrationReadinessStatus": {
      "enum": [
        "PASS",
        "FAIL",
        "PENDING",
        "DEFERRED"
      ],
      "title": "MigrationReadinessStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Four separately reported R11 readiness decisions.",
  "properties": {
    "current_scope_conformance": {
      "$ref": "#/$defs/MigrationReadinessSection"
    },
    "full_source_conformance": {
      "$ref": "#/$defs/MigrationReadinessSection"
    },
    "schedule_activation": {
      "const": "PAUSED",
      "description": "R11 readiness never activates a schedule.",
      "readOnly": true,
      "title": "Schedule Activation",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "shadow_graduation": {
      "$ref": "#/$defs/MigrationReadinessSection"
    },
    "supervised_shadow_readiness": {
      "$ref": "#/$defs/MigrationReadinessSection"
    }
  },
  "required": [
    "current_scope_conformance",
    "supervised_shadow_readiness",
    "full_source_conformance",
    "shadow_graduation",
    "schedule_activation"
  ],
  "title": "MigrationReadiness",
  "type": "object"
}
