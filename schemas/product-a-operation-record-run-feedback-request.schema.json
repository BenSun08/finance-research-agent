{
  "$defs": {
    "Capability": {
      "enum": [
        "MARKET_SUMMARY_AVAILABLE",
        "REGIME_CLASSIFICATION_AVAILABLE",
        "WATCHLIST_METRICS_AVAILABLE",
        "EVENT_RISK_CHECK_AVAILABLE",
        "SETUP_DETECTION_AVAILABLE",
        "PLAN_DRAFT_AVAILABLE",
        "POSITION_SIZING_AVAILABLE",
        "PORTFOLIO_HEAT_CHECK_AVAILABLE"
      ],
      "title": "Capability",
      "type": "string"
    },
    "CitationEntailmentReview": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "anyOf": [
              {
                "not": {
                  "required": [
                    "schema_version"
                  ]
                }
              },
              {
                "properties": {
                  "schema_version": {
                    "const": "0.1"
                  }
                },
                "required": [
                  "schema_version"
                ]
              }
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "properties": {
                    "verdict": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "verdict"
                  ]
                },
                {
                  "properties": {
                    "rationale": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "rationale"
                  ]
                },
                {
                  "properties": {
                    "reviewed_at": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "reviewed_at"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "schema_version": {
                "const": "0.2"
              }
            },
            "required": [
              "schema_version"
            ]
          },
          "then": {
            "allOf": [
              {
                "if": {
                  "properties": {
                    "verdict": {
                      "const": "SUPPORTED"
                    }
                  },
                  "required": [
                    "verdict"
                  ]
                },
                "then": {
                  "properties": {
                    "entails_claim": {
                      "const": true
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "verdict": {
                      "enum": [
                        "PARTIAL",
                        "UNSUPPORTED"
                      ]
                    }
                  },
                  "required": [
                    "verdict"
                  ]
                },
                "then": {
                  "properties": {
                    "entails_claim": {
                      "const": false
                    }
                  }
                }
              }
            ],
            "properties": {
              "rationale": {
                "pattern": "^(?=.*[!-~])[ -~]+$",
                "type": "string"
              },
              "reviewed_at": {
                "type": "string"
              },
              "verdict": {
                "enum": [
                  "SUPPORTED",
                  "PARTIAL",
                  "UNSUPPORTED"
                ],
                "type": "string"
              }
            },
            "required": [
              "verdict",
              "rationale",
              "reviewed_at"
            ]
          }
        }
      ],
      "properties": {
        "citation_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Citation Id",
          "type": "string"
        },
        "claim_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Claim Id",
          "type": "string"
        },
        "entails_claim": {
          "title": "Entails Claim",
          "type": "boolean"
        },
        "rationale": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rationale"
        },
        "reviewed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "pattern": "(?:Z|\\+00:00)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed At"
        },
        "schema_version": {
          "default": "0.1",
          "enum": [
            "0.1",
            "0.2"
          ],
          "title": "Schema Version",
          "type": "string"
        },
        "verdict": {
          "anyOf": [
            {
              "$ref": "#/$defs/CitationVerdict"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "citation_id",
        "claim_id",
        "entails_claim"
      ],
      "title": "CitationEntailmentReview",
      "type": "object"
    },
    "CitationVerdict": {
      "description": "Human-only result of reviewing citation support for one selected claim.",
      "enum": [
        "SUPPORTED",
        "PARTIAL",
        "UNSUPPORTED"
      ],
      "title": "CitationVerdict",
      "type": "string"
    },
    "ExecutiveEventState": {
      "description": "Human identification of whether material events were visible in a brief.",
      "enum": [
        "UNAVAILABLE",
        "NO_MATERIAL_EVENTS",
        "MATERIAL_EVENTS"
      ],
      "title": "ExecutiveEventState",
      "type": "string"
    },
    "ExecutiveIdentification": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "event_state": {
                "const": "MATERIAL_EVENTS"
              }
            },
            "required": [
              "event_state"
            ]
          },
          "then": {
            "properties": {
              "event_ids": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "event_state": {
                "enum": [
                  "UNAVAILABLE",
                  "NO_MATERIAL_EVENTS"
                ]
              }
            },
            "required": [
              "event_state"
            ]
          },
          "then": {
            "properties": {
              "event_ids": {
                "maxItems": 0
              }
            }
          }
        }
      ],
      "description": "Bounded human identification of executive posture, events, and priorities.",
      "properties": {
        "disabled_capabilities": {
          "items": {
            "$ref": "#/$defs/Capability"
          },
          "maxItems": 8,
          "title": "Disabled Capabilities",
          "type": "array",
          "uniqueItems": true
        },
        "event_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
            "type": "string"
          },
          "maxItems": 64,
          "title": "Event Ids",
          "type": "array",
          "uniqueItems": true
        },
        "event_state": {
          "$ref": "#/$defs/ExecutiveEventState"
        },
        "market_posture": {
          "$ref": "#/$defs/Regime"
        },
        "priority_symbols": {
          "items": {
            "maxLength": 16,
            "minLength": 1,
            "pattern": "^[A-Z][A-Z0-9]*([.-][A-Z0-9]+)*$",
            "type": "string"
          },
          "maxItems": 5,
          "title": "Priority Symbols",
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "market_posture",
        "event_state",
        "event_ids",
        "priority_symbols",
        "disabled_capabilities"
      ],
      "title": "ExecutiveIdentification",
      "type": "object"
    },
    "Regime": {
      "description": "Risk-environment taxonomy for the bounded release.",
      "enum": [
        "permissive",
        "neutral",
        "defensive",
        "unknown"
      ],
      "title": "Regime",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "anyOf": [
          {
            "not": {
              "required": [
                "schema_version"
              ]
            }
          },
          {
            "properties": {
              "schema_version": {
                "const": "0.1"
              }
            },
            "required": [
              "schema_version"
            ]
          }
        ]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "properties": {
                "executive_review_duration_seconds": {
                  "type": "integer"
                }
              },
              "required": [
                "executive_review_duration_seconds"
              ]
            },
            {
              "properties": {
                "detailed_review_duration_seconds": {
                  "type": "integer"
                }
              },
              "required": [
                "detailed_review_duration_seconds"
              ]
            },
            {
              "properties": {
                "executive_identification": {
                  "type": "object"
                }
              },
              "required": [
                "executive_identification"
              ]
            },
            {
              "properties": {
                "citation_reviews": {
                  "contains": {
                    "properties": {
                      "schema_version": {
                        "const": "0.2"
                      }
                    },
                    "required": [
                      "schema_version"
                    ]
                  }
                }
              },
              "required": [
                "citation_reviews"
              ]
            }
          ]
        }
      }
    }
  ],
  "properties": {
    "citation_reviews": {
      "default": [],
      "items": {
        "$ref": "#/$defs/CitationEntailmentReview"
      },
      "maxItems": 5,
      "title": "Citation Reviews",
      "type": "array"
    },
    "clarity_score": {
      "maximum": 5,
      "minimum": 1,
      "title": "Clarity Score",
      "type": "integer"
    },
    "detailed_review_duration_seconds": {
      "anyOf": [
        {
          "maximum": 86400,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Detailed Review Duration Seconds"
    },
    "evidence_score": {
      "maximum": 5,
      "minimum": 1,
      "title": "Evidence Score",
      "type": "integer"
    },
    "executive_identification": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExecutiveIdentification"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "executive_review_duration_seconds": {
      "anyOf": [
        {
          "maximum": 86400,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Executive Review Duration Seconds"
    },
    "notes": {
      "anyOf": [
        {
          "maxLength": 1000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Notes"
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 18,
      "pattern": "^premarket-\\d{4}-\\d{2}-\\d{2}-r[1-9]\\d*$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": "0.1",
      "enum": [
        "0.1",
        "0.2"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "usefulness_score": {
      "maximum": 5,
      "minimum": 1,
      "title": "Usefulness Score",
      "type": "integer"
    }
  },
  "required": [
    "run_id",
    "clarity_score",
    "evidence_score",
    "usefulness_score"
  ],
  "title": "RecordRunFeedbackRequest",
  "type": "object"
}
