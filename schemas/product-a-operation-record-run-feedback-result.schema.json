{
  "additionalProperties": false,
  "properties": {
    "feedback_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Feedback Id",
      "type": "string"
    },
    "recorded_at": {
      "format": "date-time",
      "pattern": "(?:[Zz]|\\+00:00)$",
      "title": "Recorded At",
      "type": "string"
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 18,
      "pattern": "^premarket-\\d{4}-\\d{2}-\\d{2}-r[1-9]\\d*$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "feedback_id",
    "run_id",
    "recorded_at"
  ],
  "title": "FeedbackReceipt",
  "type": "object"
}
