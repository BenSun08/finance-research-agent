{
  "additionalProperties": false,
  "description": "Independent declared component versions, without runtime provenance.",
  "properties": {
    "core_version": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]*$",
      "title": "Core Version",
      "type": "string"
    },
    "mcp_contract_version": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]*$",
      "title": "Mcp Contract Version",
      "type": "string"
    },
    "plugin_version": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]*$",
      "title": "Plugin Version",
      "type": "string"
    },
    "prompt_version": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]*$",
      "title": "Prompt Version",
      "type": "string"
    },
    "regime_policy_version": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]*$",
      "title": "Regime Policy Version",
      "type": "string"
    },
    "report_template_version": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]*$",
      "title": "Report Template Version",
      "type": "string"
    },
    "risk_policy_version": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]*$",
      "title": "Risk Policy Version",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "schema_versions": {
      "additionalProperties": false,
      "maxProperties": 128,
      "patternProperties": {
        "^[A-Za-z0-9][A-Za-z0-9_.:-]*$": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]*$",
          "type": "string"
        }
      },
      "propertyNames": {
        "maxLength": 128,
        "minLength": 1
      },
      "title": "Schema Versions",
      "type": "object"
    },
    "setup_policy_version": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]*$",
      "title": "Setup Policy Version",
      "type": "string"
    },
    "skill_version": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]*$",
      "title": "Skill Version",
      "type": "string"
    },
    "source_policy_version": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]*$",
      "title": "Source Policy Version",
      "type": "string"
    },
    "watchlist_version": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]*$",
      "title": "Watchlist Version",
      "type": "string"
    }
  },
  "required": [
    "core_version",
    "mcp_contract_version",
    "plugin_version",
    "skill_version",
    "prompt_version",
    "report_template_version",
    "schema_versions",
    "watchlist_version",
    "regime_policy_version",
    "setup_policy_version",
    "risk_policy_version",
    "source_policy_version"
