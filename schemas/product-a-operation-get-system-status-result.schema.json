    "market_calendar_ready": {
      "title": "Market Calendar Ready",
      "type": "boolean"
    },
    "market_data_ready": {
      "title": "Market Data Ready",
      "type": "boolean"
    },
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    }
