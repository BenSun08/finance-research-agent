{
  "$defs": {
    "ReducedReportReason": {
      "enum": [
        "SYNTHESIS_UNAVAILABLE",
        "SYNTHESIS_TIMEOUT",
        "VALIDATION_REPAIR_EXHAUSTED"
      ],
      "title": "ReducedReportReason",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "reason": {
      "$ref": "#/$defs/ReducedReportReason"
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 18,
      "pattern": "^premarket-\\d{4}-\\d{2}-\\d{2}-r[1-9]\\d*$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "reason"
  ],
  "title": "PublishReducedReportRequest",
  "type": "object"
}
