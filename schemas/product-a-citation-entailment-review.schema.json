{
  "$defs": {
    "CitationVerdict": {
      "description": "Human-only result of reviewing citation support for one selected claim.",
      "enum": [
        "SUPPORTED",
        "PARTIAL",
        "UNSUPPORTED"
      ],
      "title": "CitationVerdict",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "anyOf": [
          {
            "not": {
              "required": [
                "schema_version"
              ]
            }
          },
          {
            "properties": {
              "schema_version": {
                "const": "0.1"
              }
            },
            "required": [
              "schema_version"
            ]
          }
        ]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "properties": {
                "verdict": {
                  "type": "string"
                }
              },
              "required": [
                "verdict"
              ]
            },
            {
              "properties": {
                "rationale": {
                  "type": "string"
                }
              },
              "required": [
                "rationale"
              ]
            },
            {
              "properties": {
                "reviewed_at": {
                  "type": "string"
                }
              },
              "required": [
                "reviewed_at"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "0.2"
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "allOf": [
          {
            "if": {
              "properties": {
                "verdict": {
                  "const": "SUPPORTED"
                }
              },
              "required": [
                "verdict"
              ]
            },
            "then": {
              "properties": {
                "entails_claim": {
                  "const": true
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "verdict": {
                  "enum": [
                    "PARTIAL",
                    "UNSUPPORTED"
                  ]
                }
              },
              "required": [
                "verdict"
              ]
            },
            "then": {
              "properties": {
                "entails_claim": {
                  "const": false
                }
              }
            }
          }
        ],
        "properties": {
          "rationale": {
            "pattern": "^(?=.*[!-~])[ -~]+$",
            "type": "string"
          },
          "reviewed_at": {
            "type": "string"
          },
          "verdict": {
            "enum": [
              "SUPPORTED",
              "PARTIAL",
              "UNSUPPORTED"
            ],
            "type": "string"
          }
        },
        "required": [
          "verdict",
          "rationale",
          "reviewed_at"
        ]
      }
    }
  ],
  "properties": {
    "citation_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Citation Id",
      "type": "string"
    },
    "claim_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Claim Id",
      "type": "string"
    },
    "entails_claim": {
      "title": "Entails Claim",
      "type": "boolean"
    },
    "rationale": {
      "anyOf": [
        {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rationale"
    },
    "reviewed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "pattern": "(?:[Zz]|\\+00:00)$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reviewed At"
    },
    "schema_version": {
      "default": "0.1",
      "enum": [
        "0.1",
        "0.2"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "verdict": {
      "anyOf": [
        {
          "$ref": "#/$defs/CitationVerdict"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "citation_id",
    "claim_id",
    "entails_claim"
  ],
  "title": "CitationEntailmentReview",
  "type": "object"
}
