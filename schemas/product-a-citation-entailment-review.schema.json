{
  "$defs": {
    "CitationVerdict": {
      "description": "Human-only result of reviewing citation support for one selected claim.",
      "enum": [
        "SUPPORTED",
        "PARTIAL",
        "UNSUPPORTED"
      ],
      "title": "CitationVerdict",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "citation_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Citation Id",
      "type": "string"
    },
    "claim_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Claim Id",
      "type": "string"
    },
    "entails_claim": {
      "title": "Entails Claim",
      "type": "boolean"
    },
    "rationale": {
      "anyOf": [
        {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rationale"
    },
    "reviewed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "pattern": "(?:Z|\\+00:00)$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reviewed At"
    },
    "schema_version": {
      "default": "0.1",
      "enum": [
        "0.1",
        "0.2"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "verdict": {
      "anyOf": [
        {
          "$ref": "#/$defs/CitationVerdict"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "citation_id",
    "claim_id",
    "entails_claim"
  ],
  "title": "CitationEntailmentReview",
  "type": "object"
}
