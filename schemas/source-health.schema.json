{
  "$defs": {
    "ErrorCode": {
      "enum": [
        "CONFIGURATION_INVALID",
        "CREDENTIALS_MISSING",
        "PERMISSION_DENIED",
        "MARKET_CALENDAR_UNAVAILABLE",
        "PROVIDER_UNAVAILABLE",
        "PROVIDER_NO_DATA",
        "PROVIDER_MISSING_SESSION",
        "PROVIDER_DUPLICATE_CONFLICT",
        "PROVIDER_MALFORMED_BAR",
        "PROVIDER_STALE",
        "PROVIDER_FUTURE_OR_INCOMPLETE_BAR",
        "PROVIDER_SCHEMA_DRIFT",
        "INVALID_RESPONSE",
        "INVALID_REQUEST",
        "EVIDENCE_CUTOFF_VIOLATION",
        "SOURCE_CONFLICT",
        "STALE_DATA",
        "UNSUPPORTED_INSTRUMENT",
        "SIZING_UNAVAILABLE",
        "PORTFOLIO_HEAT_UNAVAILABLE",
        "INVALID_RUN_STATE",
        "INTERNAL_ERROR",
        "VALIDATION_FAILED",
        "PUBLICATION_FAILED",
        "PATH_NOT_ALLOWED",
        "DEADLINE_EXCEEDED"
      ],
      "title": "ErrorCode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Scoped source availability retained separately from collected values.",
  "properties": {
    "available": {
      "title": "Available",
      "type": "boolean"
    },
    "empty_valid": {
      "default": false,
      "title": "Empty Valid",
      "type": "boolean"
    },
    "error_code": {
      "anyOf": [
        {
          "$ref": "#/$defs/ErrorCode"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "message": {
      "default": "",
      "maxLength": 256,
      "title": "Message",
      "type": "string"
    },
    "provider": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Provider",
      "type": "string"
    },
    "required": {
      "title": "Required",
      "type": "boolean"
    },
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "provider",
    "available",
    "required"
  ],
  "title": "SourceHealth",
  "type": "object"
}
