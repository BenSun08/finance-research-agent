{
  "$defs": {
    "DailyReviewTimeObservation": {
      "additionalProperties": false,
      "properties": {
        "detailed_review_duration_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detailed Review Duration Seconds"
        },
        "executive_review_duration_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Executive Review Duration Seconds"
        },
        "feedback_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Feedback Id",
          "type": "string"
        },
        "market_date": {
          "format": "date",
          "title": "Market Date",
          "type": "string"
        },
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "market_date",
        "feedback_id"
      ],
      "title": "DailyReviewTimeObservation",
      "type": "object"
    },
    "DailyUsefulnessObservation": {
      "additionalProperties": false,
      "properties": {
        "corrective_work": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Corrective Work"
        },
        "feedback_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Feedback Id",
          "type": "string"
        },
        "market_date": {
          "format": "date",
          "title": "Market Date",
          "type": "string"
        },
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "usefulness_score": {
          "anyOf": [
            {
              "maximum": 5,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Usefulness Score"
        }
      },
      "required": [
        "market_date",
        "feedback_id"
      ],
      "title": "DailyUsefulnessObservation",
      "type": "object"
    },
    "EvaluationGate": {
      "additionalProperties": false,
      "description": "One ordered, evidence-backed shadow gate result.",
      "properties": {
        "evidence_ids": {
          "default": [],
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "id": {
          "$ref": "#/$defs/ShadowGateId"
        },
        "measured_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Measured Value"
        },
        "reason_codes": {
          "default": [],
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "required_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Required Value"
        },
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/EvaluationGateStatus"
        }
      },
      "required": [
        "id",
        "status"
      ],
      "title": "EvaluationGate",
      "type": "object"
    },
    "EvaluationGateStatus": {
      "enum": [
        "PASS",
        "FAIL",
        "PENDING"
      ],
      "title": "EvaluationGateStatus",
      "type": "string"
    },
    "RunDurationObservation": {
      "additionalProperties": false,
      "properties": {
        "duration_seconds": {
          "minimum": 0,
          "title": "Duration Seconds",
          "type": "integer"
        },
        "market_date": {
          "format": "date",
          "title": "Market Date",
          "type": "string"
        },
        "run_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "market_date",
        "duration_seconds"
      ],
      "title": "RunDurationObservation",
      "type": "object"
    },
    "ShadowEvaluationOrigin": {
      "enum": [
        "PERSONAL_SHADOW",
        "SYNTHETIC_EVALUATION"
      ],
      "title": "ShadowEvaluationOrigin",
      "type": "string"
    },
    "ShadowGateId": {
      "enum": [
        "AT_LEAST_TWENTY_TRADING_DAYS",
        "SAFETY",
        "DETERMINISTIC_CORRECTNESS",
        "EVIDENCE",
        "TIMELY_PUBLICATION",
        "NORMAL_PROVIDER_DURATION",
        "FAILURE_OPERATIONS",
        "REVIEW_TIME",
        "EXECUTIVE_IDENTIFICATION",
        "USEFULNESS"
      ],
      "title": "ShadowGateId",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Immutable non-P&L summary of shadow evidence and its required gates.",
  "properties": {
    "block_reason_counts": {
      "additionalProperties": false,
      "maxProperties": 128,
      "patternProperties": {
        "^[A-Za-z0-9][A-Za-z0-9_.:-]*$": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "propertyNames": {
        "maxLength": 128,
        "minLength": 1
      },
      "title": "Block Reason Counts",
      "type": "object"
    },
    "duration_observations": {
      "default": [],
      "items": {
        "$ref": "#/$defs/RunDurationObservation"
      },
      "title": "Duration Observations",
      "type": "array"
    },
    "eligible_online_days": {
      "default": 0,
      "minimum": 0,
      "title": "Eligible Online Days",
      "type": "integer"
    },
    "evidence_hashes": {
      "default": [],
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Evidence Hashes",
      "type": "array"
    },
    "failed_gate_ids": {
      "items": {
        "$ref": "#/$defs/ShadowGateId"
      },
      "readOnly": true,
      "title": "Failed Gate Ids",
      "type": "array"
    },
    "gate_results": {
      "items": {
        "$ref": "#/$defs/EvaluationGate"
      },
      "title": "Gate Results",
      "type": "array"
    },
    "graduation_ready": {
      "readOnly": true,
      "title": "Graduation Ready",
      "type": "boolean"
    },
    "origin": {
      "anyOf": [
        {
          "$ref": "#/$defs/ShadowEvaluationOrigin"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "pending_gate_ids": {
      "items": {
        "$ref": "#/$defs/ShadowGateId"
      },
      "readOnly": true,
      "title": "Pending Gate Ids",
      "type": "array"
    },
    "period_end": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Period End"
    },
    "period_start": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Period Start"
    },
    "plan_observation_counts": {
      "additionalProperties": false,
      "maxProperties": 128,
      "patternProperties": {
        "^[A-Za-z0-9][A-Za-z0-9_.:-]*$": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "propertyNames": {
        "maxLength": 128,
        "minLength": 1
      },
      "title": "Plan Observation Counts",
      "type": "object"
    },
    "published_in_target_window": {
      "default": 0,
      "minimum": 0,
      "title": "Published In Target Window",
      "type": "integer"
    },
    "regime_distribution": {
      "additionalProperties": false,
      "maxProperties": 128,
      "patternProperties": {
        "^[A-Za-z0-9][A-Za-z0-9_.:-]*$": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "propertyNames": {
        "maxLength": 128,
        "minLength": 1
      },
      "title": "Regime Distribution",
      "type": "object"
    },
    "review_time_observations": {
      "default": [],
      "items": {
        "$ref": "#/$defs/DailyReviewTimeObservation"
      },
      "title": "Review Time Observations",
      "type": "array"
    },
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "setup_distribution": {
      "additionalProperties": false,
      "maxProperties": 128,
      "patternProperties": {
        "^[A-Za-z0-9][A-Za-z0-9_.:-]*$": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "propertyNames": {
        "maxLength": 128,
        "minLength": 1
      },
      "title": "Setup Distribution",
      "type": "object"
    },
    "source_commit_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Commit Sha256"
    },
    "source_tree_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Tree Sha256"
    },
    "usefulness_observations": {
      "default": [],
      "items": {
        "$ref": "#/$defs/DailyUsefulnessObservation"
      },
      "title": "Usefulness Observations",
      "type": "array"
    },
    "valid_trading_days": {
      "default": 0,
      "minimum": 0,
      "title": "Valid Trading Days",
      "type": "integer"
    }
  },
  "required": [
    "gate_results",
    "failed_gate_ids",
    "pending_gate_ids",
    "graduation_ready"
  ],
  "title": "ShadowScorecard",
  "type": "object"
}
