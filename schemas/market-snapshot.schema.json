{
  "$defs": {
    "CompletedDailyBar": {
      "additionalProperties": false,
      "description": "One completed daily bar with its evidence and provider provenance.",
      "properties": {
        "adjustment": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Adjustment",
          "type": "string"
        },
        "close": {
          "pattern": "^(?:0*[1-9][0-9]*(?:\\.[0-9]+)?|0+\\.[0-9]*[1-9][0-9]*)$",
          "title": "Close",
          "type": "string"
        },
        "coverage": {
          "$ref": "#/$defs/Coverage"
        },
        "evidence_cutoff_at": {
          "format": "date-time",
          "pattern": "(?:Z|\\+00:00)$",
          "title": "Evidence Cutoff At",
          "type": "string"
        },
        "evidence_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Evidence Id",
          "type": "string"
        },
        "feed": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Feed",
          "type": "string"
        },
        "high": {
          "pattern": "^(?:0*[1-9][0-9]*(?:\\.[0-9]+)?|0+\\.[0-9]*[1-9][0-9]*)$",
          "title": "High",
          "type": "string"
        },
        "instrument_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Instrument Id",
          "type": "string"
        },
        "low": {
          "pattern": "^(?:0*[1-9][0-9]*(?:\\.[0-9]+)?|0+\\.[0-9]*[1-9][0-9]*)$",
          "title": "Low",
          "type": "string"
        },
        "open": {
          "pattern": "^(?:0*[1-9][0-9]*(?:\\.[0-9]+)?|0+\\.[0-9]*[1-9][0-9]*)$",
          "title": "Open",
          "type": "string"
        },
        "provider": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Provider",
          "type": "string"
        },
        "quality_flags": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
            "type": "string"
          },
          "maxItems": 64,
          "title": "Quality Flags",
          "type": "array",
          "uniqueItems": true
        },
        "retrieved_at": {
          "format": "date-time",
          "pattern": "(?:Z|\\+00:00)$",
          "title": "Retrieved At",
          "type": "string"
        },
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "session": {
          "$ref": "#/$defs/Session"
        },
        "session_date": {
          "format": "date",
          "title": "Session Date",
          "type": "string"
        },
        "source_timestamp": {
          "format": "date-time",
          "pattern": "(?:Z|\\+00:00)$",
          "title": "Source Timestamp",
          "type": "string"
        },
        "volume": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Volume"
        }
      },
      "required": [
        "instrument_id",
        "session_date",
        "source_timestamp",
        "open",
        "high",
        "low",
        "close",
        "volume",
        "session",
        "provider",
        "feed",
        "coverage",
        "adjustment",
        "retrieved_at",
        "evidence_cutoff_at",
        "evidence_id",
        "quality_flags"
      ],
      "title": "CompletedDailyBar",
      "type": "object"
    },
    "Coverage": {
      "enum": [
        "single_exchange",
        "consolidated",
        "unknown"
      ],
      "title": "Coverage",
      "type": "string"
    },
    "CurrentSessionBar": {
