        },
        "open": {
          "pattern": "^(?:0*[1-9][0-9]*(?:\\.[0-9]+)?|0+\\.[0-9]*[1-9][0-9]*)$",
          "title": "Open",
          "type": "string"
        },
        "provider": {
          "maxLength": 128,
